<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
	<!-- Self-hosted Nextcloud servers on a LAN are often plain http. User-added CAs
	     are trusted so a home server with a private certificate authority works. -->
	<base-config cleartextTrafficPermitted="true">
		<trust-anchors>
			<certificates src="system" />
			<certificates src="user" />
		</trust-anchors>
	</base-config>
</network-security-config>
